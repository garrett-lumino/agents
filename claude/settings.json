{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/agents/hooks/guard-bash.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/supply-chain-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/ml-launch-gate.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/perf-commit-gate.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/migration-explain-gate.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/bench-count-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/secret-print-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/pr-naming-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/pathspec-commit-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/heavy-job-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/secret-scan-commit.sh", "timeout": 60 }
        ]
      },
      {
        "matcher": "mcp__.*(execute_sql|apply_migration|run_sql).*",
        "hooks": [{ "type": "command", "command": "$HOME/agents/hooks/guard-bash.sh", "timeout": 10 }]
      },
      {
        "matcher": "mcp__.*hf_jobs.*",
        "hooks": [{ "type": "command", "command": "$HOME/agents/hooks/ml-launch-gate.sh", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$HOME/agents/hooks/format-on-edit.sh", "timeout": 120 },
          { "type": "command", "command": "$HOME/agents/hooks/guard-write.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/money-float-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/nolint-justification.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/index-concurrently-guard.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/pii-log-guard.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$HOME/agents/hooks/tf-plan-summary.sh", "timeout": 10 },
          { "type": "command", "command": "$HOME/agents/hooks/coderabbit-watch.sh", "timeout": 2100, "asyncRewake": true },
          { "type": "command", "command": "$HOME/agents/hooks/ci-watch.sh", "timeout": 3900, "asyncRewake": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/agents/hooks/stop-gate.sh", "timeout": 900 }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/agents/hooks/memory-to-vault.sh", "timeout": 15 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/agents/hooks/vault-commit.sh", "timeout": 15 }]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "hookify@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": false,
    "hf-cli@huggingface-skills": false,
    "cc-skills-golang@samber": false,
    "terraform@hashicorp": false,
    "posthog@posthog": false
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": { "source": { "source": "github", "repo": "multica-ai/andrej-karpathy-skills" } },
    "huggingface-skills": { "source": { "source": "github", "repo": "huggingface/skills" } }
  }
}
